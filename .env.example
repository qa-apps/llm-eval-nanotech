# =============================================================================
# Nanotech.icu Test Environment Configuration
# =============================================================================

# --- Dedicated test accounts (safe for Playwright / CI) ------------------------
# Keep real values only in the gitignored .env. CI reads them from the
# NANOTECH_TEST_EMAIL and NANOTECH_TEST_PASSWORD repository secrets.
NANOTECH_TEST_EMAIL=
NANOTECH_TEST_PASSWORD=

# --- DeepEval / LLM judge configuration ----------------------------------------
# The DeepEval judge is DeepSeek (deepseek-v4-pro); CI reads the
# DEEPSEEK_API_KEY repository secret.
DEEPSEEK_API_KEY=
RUN_LLM_EVALS=0

